if SHIELD_AEROGU38_LEFT || SHIELD_AEROGU38_RIGHT

config ZMK_SPLIT
    default y

config NFCT_PINS_AS_GPIOS
    default y

# Applies to both halves - the peripheral needs it for the header
# text ("AEROGU38"), the central for BLE advertising.
config ZMK_KEYBOARD_NAME
    default "Aerogu38"

# Auto-enable the Sharp Memory LCD widget on both halves - it decides
# internally which side compiles what (display / relay).
config ZMK_WIDGET_SHARP_LCD
    default y

endif

if SHIELD_AEROGU38_RIGHT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_AEROGU38_LEFT

# Peripheral uses the widget's status screen instead of the default
# ZMK one.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM if ZMK_DISPLAY
endchoice

endif
